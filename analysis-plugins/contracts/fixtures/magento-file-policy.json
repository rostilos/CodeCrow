  "runtimeCases": [
    {
      "name": "deepest nested framework root is used",
      "path": "services/shop/generated/code/Acme/Proxy.php",
      "evidence": ["root:services", "root:services/shop"],
      "expected": "generated"
    },
    {
      "name": "unrelated generated-looking path is outside framework root",
      "path": "generated/code/Outside/Proxy.php",
      "evidence": ["root:services/shop"],
      "expected": "full"
    },
    {
      "name": "legacy manual selection without root remains authoritative",
      "path": "generated/code/Manual/Proxy.php",
      "evidence": ["manual-project-type:magento"],
      "expected": "generated"
    },
    {
      "name": "manual selection respects its explicit root",
      "path": "packages/shop/dev/tests/integration/Fixture.php",
      "evidence": ["manual-project-type:magento", "root:packages/shop"],
      "expected": "excluded"
    },
    {
      "name": "repository root evidence applies without rebasing",
      "path": "pub/static/frontend/Acme/theme/en_US/app.js",
      "evidence": ["root:."],
      "expected": "generated"
    },
    {
      "name": "incomplete derived evidence never widens framework scope",
      "path": "generated/code/Incomplete/Proxy.php",
      "evidence": ["file:services/shop/composer.json"],
      "expected": "full"
    }
  ]
