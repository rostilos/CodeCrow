{
  "id": "django",
  "kind": "framework",
  "requires": ["python"],
  "capabilities": ["context", "graph", "index", "planning", "prompt", "validation"],
  "detection": {
    "extensions": [],
    "filesAll": [],
    "filesAny": [],
