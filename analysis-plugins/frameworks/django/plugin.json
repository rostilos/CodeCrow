      {
        "filesAll": ["pyproject.toml"],
        "filesAny": [],
        "pathPatternsAll": [],
        "pathPatternsAny": ["**/apps.py", "**/settings.py"],
        "contentMarkers": [
          {"path": "pyproject.toml", "contains": "jango"}
        ]
      },
      {
        "filesAll": ["requirements.txt"],
        "filesAny": [],
        "pathPatternsAll": [],
        "pathPatternsAny": ["**/apps.py", "**/settings.py"],
        "contentMarkers": [
          {"path": "requirements.txt", "contains": "jango"}
        ]
      },
      {
        "filesAll": ["setup.cfg"],
        "filesAny": [],
        "pathPatternsAll": [],
        "pathPatternsAny": ["**/apps.py", "**/settings.py"],
        "contentMarkers": [
          {"path": "setup.cfg", "contains": "jango"}
        ]
      }
    ]
  },
  "entrypoints": {
