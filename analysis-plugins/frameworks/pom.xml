<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.rostilos.codecrow</groupId>
        <artifactId>codecrow-parent</artifactId>
        <version>1.0</version>
        <relativePath>../../java-ecosystem/pom.xml</relativePath>
    </parent>
    <artifactId>codecrow-framework-plugins</artifactId>
    <packaging>pom</packaging>
    <name>CodeCrow Framework Plugins</name>
    <dependencies>
        <dependency>
            <groupId>org.rostilos.codecrow</groupId>
            <artifactId>codecrow-plugin-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>..</directory>
                <includes><include>plugin.json</include></includes>
                <targetPath>META-INF/codecrow/plugins/${codecrow.plugin.id}</targetPath>
            </resource>
            <resource><directory>src/main/resources</directory></resource>
        </resources>
    </build>
    <modules>
        <module>django/java</module>
        <module>ember/java</module>
        <module>express/java</module>
        <module>fastapi/java</module>
        <module>hyva/java</module>
        <module>magento/java</module>
        <module>nextjs/java</module>
        <module>quarkus/java</module>
        <module>rails/java</module>
        <module>spring/java</module>
    </modules>
</project>
