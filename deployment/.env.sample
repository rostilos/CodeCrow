# Shared production secrets required by Docker Compose.
INTERNAL_API_SECRET=secret-change-me
POSTGRES_PASSWORD=change-me-to-a-random-postgres-password
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_TO_A_STRONG_PGADMIN_PASSWORD

# Optional values with Docker Compose fallbacks.
# POSTGRES_DB=codecrow_ai
# POSTGRES_USER=codecrow_user
# PGADMIN_DEFAULT_EMAIL=pgadmin@localhost
# GITHUB_REPOSITORY_OWNER=rostilos
# RAG_UVICORN_WORKERS=1
# Third-party mcp-use telemetry is disabled by default in the inference runtime.
# MCP_USE_ANONYMIZED_TELEMETRY=false

# Optional production host-port overrides.
# Development compose has its own fallback ports when these remain unset.
# PGADMIN_HOST_PORT=5050
# RAG_PIPELINE_HOST_PORT=8001
# INFERENCE_ORCHESTRATOR_HOST_PORT=8000
# Hard PR analysis spending limits. Enforced before enrichment and LLM calls.
# ANALYSIS_MAX_FILES=150
# ANALYSIS_MAX_FILE_SIZE_BYTES=5242880
# ANALYSIS_MAX_TOTAL_DIFF_SIZE_BYTES=20971520
# ANALYSIS_MAX_TOTAL_TOKENS=1000000
# Full post-change source acquisition for PR enrichment. Keep these at least as
# large as the corresponding analysis limits unless the deployment has a
# deliberately smaller request/memory budget.
# PR_ENRICHMENT_MAX_FILE_SIZE_BYTES=5242880
# PR_ENRICHMENT_MAX_TOTAL_SIZE_BYTES=20971520
# Above this many requested files, VCS retrieval uses one repository archive.
# The same bound prevents branch analysis from issuing an uncontrolled sequence
# of provider file requests when an archive is available.
# VCS_FILE_RETRIEVAL_ARCHIVE_THRESHOLD=25
# Repository archives are rejected before indexing if any uncompressed member,
# total uncompressed content, or file count crosses these per-job bounds.
# RAG_ARCHIVE_MAX_ENTRY_SIZE_BYTES=268435456
# RAG_ARCHIVE_MAX_EXTRACTED_SIZE_BYTES=4294967296
# RAG_ARCHIVE_MAX_ENTRIES=500000
# RAG_LIFECYCLE_FAILED_RETRY_MINUTES=60

# Review workers emit liveness while a review job is active. The Java producer
# fails only after this much silence; healthy work has no total-runtime cutoff.
# ANALYSIS_QUEUE_HEARTBEAT_SECONDS=30
# ANALYSIS_QUEUE_ADMISSION_TIMEOUT_MINUTES=5
# ANALYSIS_QUEUE_INACTIVITY_TIMEOUT_MINUTES=15
# ANALYSIS_CONSUMER_HEARTBEAT_SECONDS=5

# Opt-in exact SDK HTTP request/response capture for future real review calls.
# This does not replace model calls. Artifacts contain complete proprietary source.
# Empty project IDs captures every project; comma-separated IDs restrict capture.
# Files are private and tenant/run-separated in the inference logs volume at
# /app/logs/review-quality-captures. No automatic deletion or content truncation.
# REVIEW_QUALITY_CAPTURE_ENABLED=false
# REVIEW_QUALITY_CAPTURE_PROJECT_IDS=
