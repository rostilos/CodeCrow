# CodeCrow inference-orchestrator environment template.
# Required production values are active. Optional values that have code
# fallbacks are commented and show the effective default.

# === Service-to-Service Auth (required in production) ===
# Must match SERVICE_SECRET on rag-pipeline. Leave empty only for local dev.
# Avoid ${...} sequences because python-dotenv may interpolate them.
SERVICE_SECRET=change-me-to-a-random-secret

# === HTTP and Queue Runtime ===
# AI_CLIENT_HOST=0.0.0.0
# AI_CLIENT_PORT=8000
# REDIS_URL=redis://localhost:6379/1
# MAX_CONCURRENT_REVIEWS=4
# ANALYSIS_QUEUE_HEARTBEAT_SECONDS=30
# ANALYSIS_CONSUMER_HEARTBEAT_SECONDS=5
# COMMAND_CONSUMER_HEARTBEAT_SECONDS=5
# MAX_CONCURRENT_COMMANDS=10
# COMMAND_TIMEOUT_SECONDS=600
# COMMAND_EVENT_TTL_SECONDS=3600
# COMMAND_MAX_OUTPUT_TOKENS=16384
# REVIEW_TIMEOUT_SECONDS=10800

# === MCP Runtime ===
# MCP_SERVER_JAR=/app/codecrow-vcs-mcp-1.0.jar
# PLATFORM_MCP_JAR=/app/codecrow-platform-mcp-1.0.jar
# mcp-use outbound telemetry is disabled unless an operator explicitly opts in.
MCP_USE_ANONYMIZED_TELEMETRY=false
# Optional remote-debug port; unset by default.
# MCP_DEBUG_PORT=5005
# MCP_POOL_SIZE=5
# MCP_POOL_MAX_REQUESTS=100
# MCP_POOL_MAX_AGE=3600
# MCP_POOL_ACQUIRE_TIMEOUT=30
# Total deadline for one serialized MCP tool call, including time queued behind
# another call on the same request-owned connection.
# MCP_TOOL_CALL_TIMEOUT_SECONDS=120
# CODECROW_API_URL=http://codecrow-web-application:8081
# Normally injected by Docker Compose when internal Platform API auth is enabled.
# INTERNAL_API_SECRET=

# Allow OpenAI-compatible endpoints on private/link-local networks.
# Keep false unless the configured endpoint is trusted.
# ALLOW_PRIVATE_ENDPOINTS=false

# === LLM Defaults ===
# LLM_TEMPERATURE=0.0
# OpenRouter, OpenAI, and custom OpenAI-compatible requests use a finite
# per-attempt timeout and one additional SDK retry by default.
# LLM_PROVIDER_TIMEOUT_SECONDS=120
# LLM_PROVIDER_MAX_RETRIES=1
# GEMINI_THINKING_LEVEL=low

# === Repository Context Client ===
# RAG_ENABLED=true
# RAG_API_URL=http://rag-pipeline:8001
# Optional proposed-tree tool calls fail open after this independent timeout.
# RAG_REVIEW_CONTEXT_TIMEOUT_SECONDS=120
# RAG_REVIEW_PREPARATION_TIMEOUT_SECONDS=7200
# Alternative outbound RAG auth secret when SERVICE_SECRET is not used.
# CODECROW_RAG_API_SECRET=

# === Diff Preprocessing ===
# DIFF_MAX_FILE_SIZE=25600
# DIFF_MAX_FILES=400
# DIFF_MAX_TOTAL_SIZE=1000000
# DIFF_MAX_LINES_PER_FILE=3000

# === Review Pipeline ===
# REVIEW_VERIFICATION_ENABLED=true
# REVIEW_VERIFICATION_MAX_TOOL_ROUNDS=4
# REVIEW_VERIFICATION_PROMPT_CHAR_BUDGET=64000
# REVIEW_STAGE1_MAX_FILES_PER_BATCH=15
# REVIEW_STAGE1_BATCH_TOKEN_BUDGET=60000
# Defaults to REVIEW_STAGE1_BATCH_TOKEN_BUDGET when unset.
# REVIEW_STAGE1_DIFF_CHUNK_TOKEN_BUDGET=60000
# REVIEW_STAGE1_MAX_PARALLEL=5
# Hard wall-clock deadline for one Stage 1 repository-agent batch. Expiration
# enters the existing direct structured recovery path when local-only is off.
# REVIEW_STAGE1_AGENT_TIMEOUT_SECONDS=600
# Agentic Stage 1 uses a fixed six-call ceiling and reserves the final two calls
# for structured response synthesis/correction without repository tools.
# Host-loaded proposed-tree orientation. Values are clamped to 4-64 relations
# and 2,000-32,000 prompt characters; focused graph tools handle deeper paths.
# REVIEW_STAGE1_RELATION_BRIEFING_MAX_RELATIONS=24
# REVIEW_STAGE1_RELATION_BRIEFING_MAX_CHARS=12000
# Bounded prompt projections. Complete changed hunks remain primary evidence.
# REVIEW_STAGE1_MAX_CURRENT_FILE_CHARS=12000
# REVIEW_STAGE1_CURRENT_SOURCE_BATCH_CHAR_BUDGET=48000
# REVIEW_STAGE1_METADATA_CHAR_BUDGET=24000
# REVIEW_STAGE1_METADATA_PER_FILE_CHAR_BUDGET=6000
# REVIEW_DETERMINISTIC_RAG_MAX_CHUNKS=80
# REVIEW_RAG_CONTEXT_CHAR_BUDGET=32000
# REVIEW_RAG_CONTEXT_CHUNK_CHAR_BUDGET=12000
# REVIEW_STAGE_2_ARCHITECTURE_CONTEXT_CHAR_BUDGET=64000
# Model-assisted grouped final dedup is enabled by default. Disable it to use
# deterministic exact consolidation only.
# REVIEW_LLM_DEDUP_ENABLED=true
# REVIEW_DEDUP_MAX_PARALLEL=4
# REVIEW_JSON_REPAIR_INPUT_TOKEN_TARGET=60000
# REVIEW_STRUCTURED_OUTPUT_ENABLED=true
# REVIEW_CLOUDFLARE_STRUCTURED_OUTPUT_ENABLED=false

# Testing-only full-pipeline prompt capture. Compose injects these from
# deployment/.env so pipeline-agent and inference-orchestrator use one switch.
# ANALYSIS_PROMPT_DRY_RUN_ENABLED=false
# ANALYSIS_PROMPT_DRY_RUN_SYNTHETIC_FINDINGS_PER_FILE=6
# ANALYSIS_PROMPT_DRY_RUN_SYNTHETIC_FINDINGS_MAX_TOTAL=24
# ANALYSIS_PROMPT_DRY_RUN_OUTPUT_DIR=/app/logs/prompt-dry-runs

# Opt-in immutable evidence capture around actual BYOK review-model calls.
# Requires an explicit numeric project allowlist. Artifacts contain source,
# prompts, retrieved context, and responses; provider/VCS credentials are
# redacted and files are written with mode 0600.
# REVIEW_QUALITY_CAPTURE_ENABLED=false
# REVIEW_QUALITY_CAPTURE_PROJECT_IDS=
# REVIEW_QUALITY_CAPTURE_OUTPUT_DIR=/app/logs/review-quality-captures
# REVIEW_QUALITY_CAPTURE_MAX_FILES=20

# Small/medium review classification and Stage 2 policy.
# REVIEW_FAST_CHECK_ENABLED=true
# REVIEW_STAGE_2_ENABLED=true
# REVIEW_FAST_CHECK_MAX_FILES=4
# REVIEW_FAST_CHECK_MAX_CHANGED_LINES=800
# REVIEW_FAST_CHECK_MAX_DIFF_BYTES=120000
# REVIEW_MEDIUM_MAX_FILES=15
# REVIEW_MEDIUM_MAX_CHANGED_LINES=3000
# REVIEW_MEDIUM_MAX_DIFF_BYTES=450000
# REVIEW_FAST_CHECK_DEDUP_MAX_ISSUES=5

# === Review Invocation Caps ===
# Built-in primary semantic-invocation defaults and exact optional keys:
# REVIEW_STAGE_1_TOTAL_SMALL_MAX_INVOCATIONS (4), REVIEW_STAGE_1_TOTAL_MEDIUM_MAX_INVOCATIONS (12), REVIEW_STAGE_1_TOTAL_LARGE_MAX_INVOCATIONS (24)
# REVIEW_STAGE_1_PER_UNIT_SMALL_MAX_INVOCATIONS (1), REVIEW_STAGE_1_PER_UNIT_MEDIUM_MAX_INVOCATIONS (2), REVIEW_STAGE_1_PER_UNIT_LARGE_MAX_INVOCATIONS (3)
# REVIEW_STAGE_2_PACKETS_SMALL_MAX_INVOCATIONS (1), REVIEW_STAGE_2_PACKETS_MEDIUM_MAX_INVOCATIONS (2), REVIEW_STAGE_2_PACKETS_LARGE_MAX_INVOCATIONS (4)
# REVIEW_STAGE_3_CHILDREN_SMALL_MAX_INVOCATIONS (1), REVIEW_STAGE_3_CHILDREN_MEDIUM_MAX_INVOCATIONS (2), REVIEW_STAGE_3_CHILDREN_LARGE_MAX_INVOCATIONS (4)
# REVIEW_BRANCH_RECONCILIATION_PACKETS_SMALL_MAX_INVOCATIONS (1), REVIEW_BRANCH_RECONCILIATION_PACKETS_MEDIUM_MAX_INVOCATIONS (2), REVIEW_BRANCH_RECONCILIATION_PACKETS_LARGE_MAX_INVOCATIONS (4)
# These are semantic-call ceilings. A selected structured call may make at most
# one direct-output retry with model reasoning disabled when the primary response
# is exhausted or invalid. Provider-native or provider-required limits still
# apply; CodeCrow does not add a completion cap to normal review stages.

# === Prompt Logging (Debug) ===
# PROMPT_LOG_ENABLED=false
# PROMPT_LOG_TO_FILE=false
# PROMPT_LOG_TO_CONSOLE=false
# PROMPT_LOG_DIR=/tmp/codecrow_prompts
# PROMPT_LOG_MAX_FILES=50

# === New Relic APM ===
# Set to the mounted config path to enable instrumentation; unset disables it.
# NEW_RELIC_CONFIG_FILE=/app/newrelic.ini
