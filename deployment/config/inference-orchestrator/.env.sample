# CodeCrow inference-orchestrator environment template.
# Required production values are active. Optional values that have code
# fallbacks are commented and show the effective default.

# === Service-to-Service Auth (required in production) ===
# Must match SERVICE_SECRET on rag-pipeline. Leave empty only for local dev.
# Avoid ${...} sequences because python-dotenv may interpolate them.
SERVICE_SECRET=change-me-to-a-random-secret

# === HTTP and Queue Runtime ===
# AI_CLIENT_HOST=0.0.0.0
# AI_CLIENT_PORT=8000
# REDIS_URL=redis://localhost:6379/1
# Concurrent Redis review jobs, repository-context queries, and preparation.
# Source queries and graph preparations have independent pools of this size;
# preparation waits cannot occupy the query or model-call pool.
# Default 16 allows at least 10 reviews to progress together; pending jobs stay
# in Redis until an admission slot is available. Explicit lower values remain
# effective: existing installations configured at 4 must raise them to use 16.
# MAX_CONCURRENT_REVIEWS=16
# Actual provider invocations, scheduled fairly between active reviews. Defaults
# to MAX_CONCURRENT_REVIEWS when unset; no whole-review inference admission gate.
# MAX_CONCURRENT_REVIEW_CALLS=16
# ANALYSIS_QUEUE_HEARTBEAT_SECONDS=30
# ANALYSIS_CONSUMER_HEARTBEAT_SECONDS=5
# COMMAND_CONSUMER_HEARTBEAT_SECONDS=5
# MAX_CONCURRENT_COMMANDS=10
# COMMAND_TIMEOUT_SECONDS=600
# COMMAND_EVENT_TTL_SECONDS=3600
# COMMAND_MAX_OUTPUT_TOKENS=16384
# REVIEW_TIMEOUT_SECONDS=10800

# === MCP Runtime ===
# MCP_SERVER_JAR=/app/codecrow-vcs-mcp-1.0.jar
# PLATFORM_MCP_JAR=/app/codecrow-platform-mcp-1.0.jar
# mcp-use outbound telemetry is disabled unless an operator explicitly opts in.
MCP_USE_ANONYMIZED_TELEMETRY=false
# Optional remote-debug port; unset by default.
# MCP_DEBUG_PORT=5005
# MCP_POOL_SIZE=5
# MCP_POOL_MAX_REQUESTS=100
# MCP_POOL_MAX_AGE=3600
# MCP_POOL_ACQUIRE_TIMEOUT=30
# Total deadline for one serialized MCP tool call, including time queued behind
# another call on the same request-owned connection.
# MCP_TOOL_CALL_TIMEOUT_SECONDS=120
# CODECROW_API_URL=http://codecrow-web-application:8081
# Normally injected by Docker Compose when internal Platform API auth is enabled.
# INTERNAL_API_SECRET=

# Allow OpenAI-compatible endpoints on private/link-local networks.
# Keep false unless the configured endpoint is trusted.
# ALLOW_PRIVATE_ENDPOINTS=false

# === LLM Defaults ===
# LLM_TEMPERATURE=0.0
# OpenRouter, OpenAI, and custom OpenAI-compatible requests use a finite
# transport inactivity timeout and one additional SDK retry by default.
# LLM_PROVIDER_TIMEOUT_SECONDS=120
# LLM_PROVIDER_MAX_RETRIES=1
# Elapsed deadline for one review provider invocation after model-slot admission.
# Internal OpenRouter streams are closed on timeout; partial streams are not replayed.
# REVIEW_MODEL_CALL_TIMEOUT_SECONDS=900
# GEMINI_THINKING_LEVEL=low

# === Repository Context Client ===
# RAG_ENABLED=true
# RAG_API_URL=http://rag-pipeline:8001
# Optional proposed-tree tool calls fail open after this independent timeout.
# RAG_REVIEW_CONTEXT_TIMEOUT_SECONDS=120
# RAG_REVIEW_PREPARATION_TIMEOUT_SECONDS=7200
# Alternative outbound RAG auth secret when SERVICE_SECRET is not used.
# CODECROW_RAG_API_SECRET=

# === Diff Preprocessing ===
# DIFF_MAX_FILE_SIZE=25600
# DIFF_MAX_FILES=400
# DIFF_MAX_TOTAL_SIZE=1000000
# DIFF_MAX_LINES_PER_FILE=3000

# === Review Pipeline ===
# REVIEW_EXECUTION_MODE=pipeline
# Use mcp_only for graph-first agent planning, focused tool-driven analysis,
# and independent on-demand source verification. Keep RAG_ENABLED=true for
# graph access. Internal reviewExecutionMode overrides this default per job.
# The planner selects complete changed scopes and related contracts. Discovery
# is tool-free; source-seeded verification cases use request-bound read tools,
# followed by semantic publication reconciliation. MAX_CONCURRENT_REVIEWS above
# bounds worker concurrency. Review context has no stage token/file/read quotas.

# Opt-in exact SDK HTTP request/response capture around actual review calls.
# Compose injects these values from deployment/.env. For standalone inference,
# set them here. Empty project IDs captures every project; comma-separated IDs
# restrict capture. Artifacts retain complete source and native tool schemas;
# transport auth headers/query values are not stored. Files are mode 0600,
# tenant/run directories mode 0700. The service-owned root may be 0755 but
# must not be group/world-writable. Capture failures
# log a diagnostic and do not fail analysis. No automatic deletion or clipping.
# REVIEW_QUALITY_CAPTURE_ENABLED=false
# REVIEW_QUALITY_CAPTURE_PROJECT_IDS=
# REVIEW_QUALITY_CAPTURE_OUTPUT_DIR=/app/logs/review-quality-captures

# === New Relic APM ===
# Set to the mounted config path to enable instrumentation; unset disables it.
# NEW_RELIC_CONFIG_FILE=/app/newrelic.ini
