# CodeCrow rag-pipeline environment template.
# Required production values are active. Optional values that have code
# fallbacks are commented and show the effective default.

# === Service-to-Service Auth (required in production) ===
# Must match SERVICE_SECRET on inference-orchestrator. Leave empty only for dev.
SERVICE_SECRET=change-me-to-a-random-secret

# === Structural Index Storage ===
# Persistent root for immutable SQLite repository-index generations.
# Docker Compose mounts the structural_index_data volume at this path.
# STRUCTURAL_INDEX_ROOT=/var/lib/codecrow/structural-index

# === Build Coordination and Server Runtime ===
# REDIS_URL=redis://redis:6379/1
# Full repository builds from HTTP/SSE share this process-wide slot.
# Keep it at one unless the host has capacity for concurrent structural builds.
# RAG_FULL_INDEX_CONCURRENCY=4
# RAG_REVIEW_PREPARATION_WAIT_SECONDS=600
# Heartbeat frames keep quiet HTTP/SSE exact-branch builds observable and reset
# the Java client's read-idle timeout without changing durable job progress.
# RAG_INDEX_STREAM_HEARTBEAT_SECONDS=15
# Repository-plugin finalization is optional enrichment. At this deadline it is
# omitted and structural indexing continues with a recoverable diagnostic.
# RAG_ARCHITECTURE_FINALIZATION_TIMEOUT_SECONDS=600
# Keep one API process by default. Increase only when the host has enough
# capacity for another structural-index worker.
# UVICORN_WORKERS=1
# Project mutation coordination is correctness-critical in multi-worker setups.
# RAG_MUTATION_LEASE_SECONDS=300
# RAG_MUTATION_ACQUIRE_TIMEOUT_SECONDS=5
# Request-scoped proposed-tree generations are reused across review batches and
# removed after this many seconds without a graph read (default: 6 hours).
# RAG_REVIEW_GENERATION_TTL_SECONDS=21600
# RAG_PENDING_JANITOR_INTERVAL_SECONDS=3600
# === Repository and API Safety Limits ===
# Root directory that repo_path arguments may resolve under.
# ALLOWED_REPO_ROOT=/tmp
# Whole files above this byte ceiling are skipped before structural parsing;
# their content is never partially indexed.
# RAG_MAX_FILE_SIZE_BYTES=524288
# RAG_MAX_FILES_PER_INDEX=50000
# RAG_MAX_CHUNKS_PER_INDEX=1000000
# RAG_MAX_IDENTIFIERS_PER_QUERY=100
# === New Relic APM ===
# Production Compose sets this to the mounted agent configuration automatically.
# Leave it unset for uninstrumented local runs.
# NEW_RELIC_CONFIG_FILE=/app/newrelic.ini
