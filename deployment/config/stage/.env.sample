# Contents of STAGE_ENV_DEPLOYMENT (Compose configuration).
# Choose separate stage credentials. Quote values containing $ with single quotes.
GITHUB_REPOSITORY_OWNER=your-lowercase-github-owner
POSTGRES_DB=codecrow_stage
POSTGRES_USER=codecrow_stage
POSTGRES_PASSWORD=replace-with-a-stage-db-password
INTERNAL_API_SECRET=replace-with-a-stage-service-secret

# These ports bind to loopback; configure a reverse proxy for stage domains.
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
WEB_SERVER_HOST_PORT=18081
PIPELINE_AGENT_HOST_PORT=18082
INFERENCE_ORCHESTRATOR_HOST_PORT=18000
RAG_PIPELINE_HOST_PORT=18001
WEB_FRONTEND_HOST_PORT=18080

# Optional database administration: docker compose --profile tools up -d pgadmin
PGADMIN_HOST_PORT=15050
PGADMIN_DEFAULT_EMAIL=stage-admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-stage-admin-password

# Java dispatch capacity; Python build capacity lives in STAGE_ENV_RAG_PIPELINE.
RAG_BRANCH_BUILD_PARALLELISM=16
# Overrides the Docker image's UVICORN_WORKERS default; size for available memory.
RAG_UVICORN_WORKERS=1
