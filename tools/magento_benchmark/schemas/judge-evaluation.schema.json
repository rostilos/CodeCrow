{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judge-evaluation.schema.json",
  "title": "CodeCrow Magento 2 blinded judge evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "studyId",
    "registrationDigest",
    "corpusDigest",
    "createdAt",
    "mode",
    "caseIds",
    "judgePlanIds",
    "subjects",
    "policy",
    "records",
    "adjudications",
    "humanHumanAgreement",
    "judgeHumanEvaluation",
    "judgeEvaluationDigest"
  ],
  "properties": {
    "kind": {
      "const": "codecrow-magento2-judge-evaluation"
    },
    "studyId": {
      "type": "string",
      "minLength": 1
    },
    "registrationDigest": {
      "$ref": "#/$defs/sha256"
    },
    "corpusDigest": {
      "$ref": "#/$defs/sha256"
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "mode": {
      "enum": [
        "development_calibration",
        "blinded_human_audit"
      ]
    },
    "caseIds": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "judgePlanIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectPolicy",
        "minimumIndependentRaters",
        "agreementMetric",
        "minimumAgreement",
        "disagreementResolution",
        "modelIdentityBlinded"
      ],
      "properties": {
        "subjectPolicy": {
          "const": "all_pair_and_novel_decisions_for_every_planned_judgment_and_case"
        },
        "minimumIndependentRaters": {
          "type": "integer",
          "minimum": 2
        },
        "agreementMetric": {
          "const": "percent_pairwise_agreement"
        },
        "minimumAgreement": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1
        },
        "disagreementResolution": {
          "const": "independent_adjudicator"
        },
        "modelIdentityBlinded": {
          "const": true
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "adjudications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adjudication"
      }
    },
    "humanHumanAgreement": {
      "$ref": "#/$defs/rate"
    },
    "judgeHumanEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agreement",
        "confusion",
        "subjectCount"
      ],
      "properties": {
        "agreement": {
          "$ref": "#/$defs/rate"
        },
        "confusion": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/confusion"
          }
        },
        "subjectCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "judgeEvaluationDigest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decisionKind": {
      "enum": [
        "pair",
        "novel"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "subjectId",
        "judgmentId",
        "caseId",
        "decisionKind",
        "goldId",
        "candidateId",
        "judgeDecisionDigest",
        "judgeVerdict"
      ],
      "properties": {
        "subjectId": {
          "type": "string",
          "pattern": "^m2e-[0-9a-f]{64}$"
        },
        "judgmentId": {
          "type": "string",
          "minLength": 1
        },
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "decisionKind": {
          "$ref": "#/$defs/decisionKind"
        },
        "goldId": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidateId": {
          "type": "string",
          "pattern": "^C[0-9]{3}$"
        },
        "judgeDecisionDigest": {
          "$ref": "#/$defs/sha256"
        },
        "judgeVerdict": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "allOf": [
        {
          "$ref": "#/$defs/subject"
        },
        {
          "type": "object",
          "required": [
            "annotator",
            "humanVerdict",
            "modelIdentityBlinded",
            "at",
            "recordDigest"
          ],
          "properties": {
            "annotator": {
              "type": "string",
              "minLength": 1
            },
            "humanVerdict": {
              "type": "string",
              "minLength": 1
            },
            "modelIdentityBlinded": {
              "const": true
            },
            "at": {
              "$ref": "#/$defs/timestamp"
            },
            "recordDigest": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "adjudication": {
      "allOf": [
        {
          "$ref": "#/$defs/subject"
        },
        {
          "type": "object",
          "required": [
            "adjudicator",
            "finalHumanVerdict",
            "sourceRecordDigests",
            "modelIdentityBlinded",
            "at",
            "rationale",
            "adjudicationDigest"
          ],
          "properties": {
            "adjudicator": {
              "type": "string",
              "minLength": 1
            },
            "finalHumanVerdict": {
              "type": "string",
              "minLength": 1
            },
            "sourceRecordDigests": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/sha256"
              }
            },
            "modelIdentityBlinded": {
              "const": true
            },
            "at": {
              "$ref": "#/$defs/timestamp"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "adjudicationDigest": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "confusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionKind",
        "judgeVerdict",
        "humanVerdict",
        "count"
      ],
      "properties": {
        "decisionKind": {
          "$ref": "#/$defs/decisionKind"
        },
        "judgeVerdict": {
          "type": "string",
          "minLength": 1
        },
        "humanVerdict": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
