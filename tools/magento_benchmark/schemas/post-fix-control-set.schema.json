{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "post-fix-control-set.schema.json",
  "title": "CodeCrow Magento 2 verified-F control set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "createdAt",
    "registrationDigest",
    "corpusDigest",
    "controls",
    "controlSetDigest"
  ],
  "properties": {
    "kind": {
      "const": "codecrow-magento2-post-fix-control-set"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "registrationDigest": {
      "$ref": "#/$defs/sha256"
    },
    "corpusDigest": {
      "$ref": "#/$defs/sha256"
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "controlId",
          "controlDigest"
        ],
        "properties": {
          "controlId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "controlDigest": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "controlSetDigest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
